@model List<Appointment>
@{ ViewData["Title"] = "My Appointments"; var upcoming = Model.Where(a => a.AppointmentDate.Date >= DateTime.Today && a.Status != "Cancelled").OrderBy(a => a.AppointmentDate).ThenBy(a => a.AppointmentTime).ToList(); var past = Model.Except(upcoming).OrderByDescending(a => a.AppointmentDate).ThenByDescending(a => a.AppointmentTime).ToList(); }
<section class="page-hero"><div class="container"><h1>My Appointments</h1><p>Review your upcoming and previous clinic bookings.</p></div></section><section class="section"><div class="container narrow">
@if(TempData["Error"] is string error){<div class="alert-error">@error</div>}
<div class="section-title left-title"><h2>Upcoming appointments</h2><span></span></div>
@if(!upcoming.Any()){<div class="empty-state"><i class="fa-regular fa-calendar-xmark"></i><h2>No upcoming appointments</h2><p>Choose a doctor and book your next visit.</p><a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">Browse doctors</a></div>}
@foreach(var a in upcoming){<div class="appointment-card"><img src="@a.Doctor?.ImageUrl" onerror="this.src='/images/clinic-hero.jpg'" alt="@a.Doctor?.Name"/><div class="appointment-info"><h3>@a.Doctor?.Name</h3><p>@a.Doctor?.Specialty.Name</p><div><i class="fa-regular fa-calendar"></i> @a.AppointmentDate.ToString("dd MMMM yyyy") &nbsp; <i class="fa-regular fa-clock"></i> @a.AppointmentTime</div><small>Booking No. <strong>@a.BookingNumber</strong></small></div><div class="appointment-side"><span class="status @a.Status.ToLower()">@a.Status</span><div class="appointment-actions"><a asp-action="Reschedule" asp-route-id="@a.Id" class="btn btn-outline btn-sm">Reschedule</a><form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@a.Id"/><button class="link-danger" type="submit" onclick="return confirm('Are you sure you want to cancel this appointment?')">Cancel</button></form></div></div></div>}
<div class="section-title left-title history-title"><h2>Past & cancelled</h2><span></span></div>
@foreach(var a in past){<div class="appointment-card past-card"><img src="@a.Doctor?.ImageUrl" onerror="this.src='/images/clinic-hero.jpg'" alt="@a.Doctor?.Name"/><div class="appointment-info"><h3>@a.Doctor?.Name</h3><p>@a.Doctor?.Specialty.Name</p><div>@a.AppointmentDate.ToString("dd MMMM yyyy") · @a.AppointmentTime</div><small>Booking No. <strong>@a.BookingNumber</strong></small></div><div class="appointment-side"><span class="status @a.Status.ToLower()">@a.Status</span></div></div>}
</div></section>
