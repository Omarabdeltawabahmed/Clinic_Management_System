@model BookingViewModel
@{ ViewData["Title"] = "Reschedule Appointment"; var id = Context.Request.RouteValues["id"]; }
<section class="section"><div class="container narrow"><div class="form-card"><div class="booking-doctor"><img src="@Model.Doctor.ImageUrl" onerror="this.src='/images/clinic-hero.jpg'" alt="@Model.Doctor.Name"/><div><span class="eyebrow">Reschedule appointment</span><h1>@Model.Doctor.Name</h1><p>@Model.Doctor.Specialty.Name</p></div></div><form asp-action="Reschedule" asp-route-id="@id" method="post" id="bookingForm"><input asp-for="DoctorId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="AppointmentDate">New date</label><input asp-for="AppointmentDate" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" class="form-control" id="appointmentDate"/><span asp-validation-for="AppointmentDate" class="validation"></span><label>Available time slots</label><div id="slots" class="slot-grid">@foreach(var slot in Model.Slots){<button type="button" class="time-slot @(slot.IsBooked?"booked":"")" data-time="@slot.Time" @(slot.IsBooked?"disabled":"")>@slot.Time</button>}</div><input asp-for="AppointmentTime" type="hidden" id="appointmentTime"/><span asp-validation-for="AppointmentTime" class="validation"></span><label asp-for="Notes">Notes (optional)</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea><button class="btn btn-primary btn-lg full" type="submit">Save new appointment time</button></form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.addEventListener('DOMContentLoaded',()=>{const date=document.getElementById('appointmentDate'),slots=document.getElementById('slots'),hidden=document.getElementById('appointmentTime'),doctor='@Model.DoctorId';function bind(){slots.querySelectorAll('.time-slot:not(.booked)').forEach(b=>b.onclick=()=>{slots.querySelectorAll('.time-slot').forEach(x=>x.classList.remove('selected'));b.classList.add('selected');hidden.value=b.dataset.time;});}async function load(){hidden.value='';slots.innerHTML='<p class="muted">Loading...</p>';const r=await fetch('@Url.Action("Slots","Appointments")?doctorId='+doctor+'&date='+encodeURIComponent(date.value));const data=await r.json();slots.innerHTML=data.length?data.map(x=>`<button type="button" class="time-slot ${x.isBooked?'booked':''}" data-time="${x.time}" ${x.isBooked?'disabled':''}>${x.time}</button>`).join(''):'<p class="muted">No working hours on this date.</p>';bind();}date.addEventListener('change',load);bind();});</script> }
