@model AIChatViewModel
@{ ViewData["Title"] = "MediCare Assistant"; }
<section class="page-hero"><div class="container"><p class="eyebrow">Smart Clinic Assistant</p><h1>How can we guide you?</h1><p>Describe what you are experiencing and I can suggest the most relevant specialty and doctors available at MediCare.</p></div></section>
<section class="section"><div class="container narrow"><div class="ai-card"><div class="ai-header"><div class="ai-avatar"><i class="fa-solid fa-wand-magic-sparkles"></i></div><div><h2>MediCare Assistant</h2><p>Powered by your clinic's doctor data</p></div></div><div class="ai-disclaimer"><i class="fa-solid fa-circle-info"></i> This assistant is for guidance only. <strong>It is not medical advice and does not provide a diagnosis.</strong></div><div class="chat-history">@if(!Model.Messages.Any()){<div class="ai-welcome"><i class="fa-solid fa-comments"></i><h3>Tell me what you need help with</h3><p>For example: “I have frequent headaches and dizziness.”</p></div>}@foreach(var m in Model.Messages){<div class="chat-message @m.Role"><span class="chat-label">@(m.Role=="user"?"You":"MediCare Assistant")</span><div><span class="chat-text">@m.Content</span></div></div>}</div><form asp-action="Ask" method="post" class="ai-form"><input asp-for="Message" class="form-control" placeholder="Describe your symptoms or concern..." autocomplete="off"/><button class="btn btn-primary" type="submit"><i class="fa-solid fa-paper-plane"></i> Send</button></form><form asp-action="Clear" method="post" class="ai-clear"><button class="link-danger" type="submit">Clear conversation</button></form></div></div></section>
