@model IEnumerable<Clinic_System.Models.Doctor>

@{
    ViewData["Title"] = "Doctors Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-1">Doctors Management</h3>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus"></i> Add New Doctor
            </a>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Doctor</th>
                        <th>Specialty</th>
                        <th>Contact Info</th>
                        <th>Salary</th>
                        <th>Consultation Fee</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="text-end pe-4">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("Admin") ? 6 : 5)" class="text-center py-5 text-muted">
                                <h5>No doctors added yet.</h5>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.ProfilePictureUrl))
                                        {
                                            <img src="@item.ProfilePictureUrl"
                                                 alt="@item.Name"
                                                 class="rounded-circle border shadow-sm"
                                                 width="45"
                                                 height="45"
                                                 style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center fw-bold border"
                                                 style="width: 45px; height: 45px; min-width: 45px;">
                                                @(string.IsNullOrEmpty(item.Name) ? "D" : item.Name.Substring(0, 1).ToUpper())
                                            </div>
                                        }

                                        <div>
                                            <div class="fw-bold text-dark">@item.Name</div>
                                            <div class="text-muted small">ID: #@item.Id</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                                        @(item.Specialty != null ? item.Specialty.Name : "N/A")
                                    </span>
                                </td>

                                <td>
                                    <div class="small">
                                        <div><i class="bi bi-envelope text-muted me-1"></i> @item.Email</div>
                                        <div class="text-muted"><i class="bi bi-telephone text-muted me-1"></i> @item.Phone</div>
                                    </div>
                                </td>

                                <td class="fw-bold text-dark">
                                    $@($"{item.Salary:N0}")
                                </td>

                                <td class="fw-bold text-success">
                                    $@($"{item.Fee:N2}")
                                </td>

                                @if (User.IsInRole("Admin"))
                                {
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-circle" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>