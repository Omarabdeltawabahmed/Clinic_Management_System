@model DoctorProfileViewModel
@{ ViewData["Title"] = Model.Doctor.Name; var d = Model.Doctor; }
<section class="page-hero"><div class="container"><p class="eyebrow">Doctor Profile</p><h1>@d.Name</h1><p>@d.Specialty.Name · @d.YearsExperience years of experience</p></div></section>
<section class="section"><div class="container"><div class="profile-card professional-profile"><div><img class="profile-photo" src="@(string.IsNullOrWhiteSpace(d.ImageUrl)?"/images/clinic-hero.jpg":d.ImageUrl)" onerror="this.src='/images/clinic-hero.jpg'" alt="@d.Name"/><div class="profile-cta"><a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@d.Id" class="btn btn-primary btn-lg full">Book an appointment</a></div></div><div class="profile-content"><span class="eyebrow">@d.Specialty.Name</span><h1>@d.Name</h1><p>@d.Bio</p><div class="profile-stats"><div><strong>@d.Rating.ToString("0.0") ★</strong><span>Patient rating · @d.ReviewsCount reviews</span></div><div><strong>@d.YearsExperience+</strong><span>Years experience</span></div><div><strong>@d.ConsultationFee.ToString("0") EGP</strong><span>Consultation fee</span></div></div><div class="detail-grid"><div class="detail-box"><i class="fa-solid fa-graduation-cap"></i><div><strong>Education</strong><p>@d.Education</p></div></div><div class="detail-box"><i class="fa-solid fa-certificate"></i><div><strong>Qualifications & Certificates</strong><p>@d.Qualifications</p></div></div><div class="detail-box"><i class="fa-regular fa-clock"></i><div><strong>Working hours</strong><p>@d.WorkingHours</p></div></div><div class="detail-box"><i class="fa-solid fa-language"></i><div><strong>Languages</strong><p>@d.Languages</p></div></div><div class="detail-box"><i class="fa-solid fa-door-open"></i><div><strong>Clinic room</strong><p>@d.ClinicRoom</p></div></div><div class="detail-box"><i class="fa-solid fa-stopwatch"></i><div><strong>Visit duration</strong><p>@d.VisitDurationMinutes minutes per visit</p></div></div></div><div class="schedule-block"><h2>Weekly schedule</h2><div class="schedule-list">@foreach(var w in Model.WorkingDays){<div><strong>@w.WorkingDay.Name</strong><span>@DateTime.Today.Add(w.StartTime).ToString("hh:mm tt") – @DateTime.Today.Add(w.EndTime).ToString("hh:mm tt")</span></div>}</div></div></div></div></div></section>
