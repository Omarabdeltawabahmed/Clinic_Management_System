@model Clinic_System.Models.MedicalRecord

@{
    ViewData["Title"] = "Create Medical Record";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-primary text-white py-3 rounded-top-4">
                    <h5 class="fw-bold mb-0">📋 Add Consultation & Prescription</h5>
                </div>
                <div class="card-body p-4">
                    <h6 class="text-muted mb-3">Patient Name: <strong class="text-dark">@ViewBag.PatientName</strong></h6>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-action="CreateRecord" method="post" enctype="multipart/form-data">
                        <!-- اربط الـ Hidden input بالموديل مباشرة -->
                        <input type="hidden" asp-for="AppointmentId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Patient Complaint</label>
                            <textarea asp-for="Complaint" class="form-control" rows="2" placeholder="Enter patient complaint..."></textarea>
                            <span asp-validation-for="Complaint" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Diagnosis / Case Details</label>
                            <textarea asp-for="Diagnosis" class="form-control" rows="3" placeholder="Enter diagnosis notes..."></textarea>
                            <span asp-validation-for="Diagnosis" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Prescription / Treatment Plan</label>
                            <textarea asp-for="Prescription" class="form-control" rows="4" placeholder="Write prescription / medicine instructions..."></textarea>
                            <span asp-validation-for="Prescription" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Attachment (X-Ray, Lab Report, etc.)</label>
                            <input type="file" name="attachment" class="form-control" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold">Save & Complete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>