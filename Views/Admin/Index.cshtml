@{ ViewData["Title"] = "Admin Dashboard"; }
<section class="page-hero"><div class="container"><h1>Admin Dashboard</h1><p>Quick overview of the MediCare Clinic system.</p></div></section><section class="section"><div class="container"><div class="stats-grid"><div class="stat-card"><i class="fa-solid fa-user-doctor"></i><strong>@ViewBag.Doctors</strong><span>Doctors</span></div><div class="stat-card"><i class="fa-solid fa-stethoscope"></i><strong>@ViewBag.Specialties</strong><span>Specialties</span></div><div class="stat-card"><i class="fa-regular fa-calendar-check"></i><strong>@ViewBag.Appointments</strong><span>Appointments</span></div><div class="stat-card"><i class="fa-regular fa-hourglass-half"></i><strong>@ViewBag.Pending</strong><span>Pending</span></div></div></div></section>
