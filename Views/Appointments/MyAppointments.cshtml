@model List<Appointment>
@{ ViewData["Title"] = "My Appointments"; }
<section class="page-hero"><div class="container"><h1>My Appointments</h1><p>Review your upcoming and previous clinic bookings.</p></div></section><section class="section"><div class="container narrow">@if(!Model.Any()){<div class="empty-state"><i class="fa-regular fa-calendar-xmark"></i><h2>No appointments yet</h2><p>Choose a doctor and book your first visit.</p><a asp-controller="Doctors" asp-action="Index" class="btn btn-primary">Browse doctors</a></div>}@foreach(var a in Model){<div class="appointment-card"><img src="@a.Doctor.ImageUrl" alt="@a.Doctor.Name"/><div class="appointment-info"><h3>@a.Doctor.Name</h3><p>@a.Doctor.Specialty.Name</p><div><i class="fa-regular fa-calendar"></i> @a.AppointmentDate.ToString("dd MMMM yyyy") &nbsp; <i class="fa-regular fa-clock"></i> @a.AppointmentTime</div></div><div class="appointment-side"><span class="status @a.Status.ToLower()">@a.Status</span>@if(a.Status != "Cancelled"){<form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@a.Id"/><button class="link-danger" type="submit">Cancel appointment</button></form>}</div></div>}</div></section>
