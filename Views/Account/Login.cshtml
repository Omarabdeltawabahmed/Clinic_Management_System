@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<section class="section"><div class="container auth-container"><div class="form-card"><h1>Welcome back</h1><p class="muted">Log in to manage your appointments.</p><form method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="validation"></div><label>Email</label><input asp-for="Email" class="form-control" placeholder="you@example.com"/><label>Password</label><input asp-for="Password" class="form-control" placeholder="Your password"/><label class="check-row"><input asp-for="RememberMe"/> Remember me</label><button class="btn btn-primary btn-lg full">Log in</button></form><p class="auth-foot">New here? <a asp-action="Register">Create an account</a></p></div></div></section>
