@model RegisterViewModel
@{ ViewData["Title"] = "Create Account"; }
<section class="section"><div class="container auth-container"><div class="form-card"><h1>Create your account</h1><p class="muted">Register once, then manage all of your bookings in one place.</p><form method="post"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Full name</label><input asp-for="FullName" class="form-control"/><label>Email</label><input asp-for="Email" class="form-control"/><label>Password</label><input asp-for="Password" class="form-control"/><label>Confirm password</label><input asp-for="ConfirmPassword" class="form-control"/><button class="btn btn-primary btn-lg full">Create Account</button></form><p class="auth-foot">Already have an account? <a asp-action="Login">Log in</a></p></div></div></section>
