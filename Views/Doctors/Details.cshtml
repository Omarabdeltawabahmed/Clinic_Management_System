@model Doctor
@{ ViewData["Title"] = Model.Name; }
<section class="section"><div class="container"><div class="profile-card"><img src="@Model.ImageUrl" alt="@Model.Name" class="profile-photo"/><div class="profile-content"><span class="eyebrow">@Model.Specialty.Name</span><h1>@Model.Name</h1><div class="rating"><span>★★★★★</span> @Model.Rating.ToString("0.0") · @Model.ReviewsCount reviews</div><p>@Model.Bio</p><div class="profile-stats"><div><strong>@Model.YearsExperience+</strong><span>Years experience</span></div><div><strong>@Model.ConsultationFee.ToString("0") EGP</strong><span>Consultation fee</span></div><div><strong>Available</strong><span>Booking status</span></div></div><a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@Model.Id" class="btn btn-primary btn-lg">Book appointment</a></div></div></div></section>
