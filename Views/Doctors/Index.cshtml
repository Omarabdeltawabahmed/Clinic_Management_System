@model List<Doctor>
@{ ViewData["Title"] = "Doctors"; var specialties = ViewBag.Specialties as List<Specialty> ?? new(); int? selected = ViewBag.SelectedSpecialty as int?; }
<section class="page-hero"><div class="container"><h1>Find Your Doctor</h1><p>Browse trusted specialists and book the right appointment for you.</p></div></section>
<section class="section"><div class="container"><div class="filter-chips"><a asp-action="Index" class="chip @(selected == null ? "active" : "")">All</a>@foreach(var s in specialties){<a asp-action="Index" asp-route-specialtyId="@s.Id" class="chip @(selected == s.Id ? "active" : "")">@s.Name</a>}</div><div class="doctor-grid">@foreach(var doctor in Model){<article class="doctor-card"><img src="@doctor.ImageUrl" alt="@doctor.Name" class="doctor-photo"/><h3>@doctor.Name</h3><p class="muted">@doctor.Specialty.Name Consultant</p><div class="rating"><span>★★★★★</span> @doctor.Rating.ToString("0.0")</div><div class="fee">@doctor.ConsultationFee.ToString("0") EGP</div><div class="card-actions"><a asp-action="Details" asp-route-id="@doctor.Id" class="btn btn-outline btn-sm">Profile</a><a asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@doctor.Id" class="btn btn-primary btn-sm">Book now</a></div></article>}</div></div></section>
