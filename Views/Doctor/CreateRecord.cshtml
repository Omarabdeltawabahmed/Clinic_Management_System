@model ClinicManagementSystem.Models.MedicalRecord

@{
    ViewData["Title"] = "Add Medical Record";
}

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">New Medical Record</h4>
            <a asp-action="PatientHistory" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-light btn-sm fw-bold" target="_blank">
                View Patient History
            </a>
        </div>
        <div class="card-body">
            <h5 class="card-subtitle mb-3 text-muted">Patient: <strong>@ViewBag.PatientName</strong></h5>
            <hr />

            <form asp-action="CreateRecord" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="AppointmentId" />

                <div class="mb-3">
                    <label asp-for="Complaint" class="form-label fw-bold"></label>
                    <textarea asp-for="Complaint" class="form-control" rows="2" placeholder="Enter patient's complaint..."></textarea>
                    <span asp-validation-for="Complaint" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Diagnosis" class="form-label fw-bold"></label>
                    <input asp-for="Diagnosis" class="form-control" placeholder="Enter diagnosis..." />
                    <span asp-validation-for="Diagnosis" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Prescription" class="form-label fw-bold"></label>
                    <textarea asp-for="Prescription" class="form-control" rows="4" placeholder="Enter medication and treatment details..."></textarea>
                    <span asp-validation-for="Prescription" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Attachment (Lab/X-Ray PDF or Image)</label>
                    <input type="file" name="attachment" class="form-control" accept=".pdf,.png,.jpg,.jpeg" />
                </div>

                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Save & Finish Visit</button>
                </div>
            </form>
        </div>
    </div>
</div>