@model IEnumerable<ClinicManagementSystem.Models.Appointment>

@{
    ViewData["Title"] = "Today's Appointments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calendar-check"></i> Today's Appointments</h2>
        <span class="badge bg-primary fs-6">@DateTime.Today.ToString("dd MMM yyyy")</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No appointments scheduled for today.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle bg-white mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Time</th>
                        <th>Patient Name</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AppointmentDate.ToString("hh:mm tt")</td>
                            <td class="fw-bold">@item.PatientName</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case ClinicManagementSystem.Models.AppointmentStatus.Waiting:
                                        <span class="badge bg-warning text-dark">Waiting</span>
                                        break;
                                    case ClinicManagementSystem.Models.AppointmentStatus.InProgress:
                                        <span class="badge bg-info text-dark">In Progress</span>
                                        break;
                                    case ClinicManagementSystem.Models.AppointmentStatus.Done:
                                        <span class="badge bg-success">Done</span>
                                        break;
                                    case ClinicManagementSystem.Models.AppointmentStatus.NoShow:
                                        <span class="badge bg-secondary">No Show</span>
                                        break;
                                    default:
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <form asp-action="UpdateStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="@ClinicManagementSystem.Models.AppointmentStatus.InProgress" />
                                        <button type="submit" class="btn btn-sm btn-outline-info" title="Start Visit">
                                            Start
                                        </button>
                                    </form>

                                    <a asp-action="CreateRecord" asp-route-appointmentId="@item.Id" class="btn btn-sm btn-success ms-1">
                                        Medical Record
                                    </a>

                                    <form asp-action="UpdateStatus" method="post" class="d-inline ms-1">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="status" value="@ClinicManagementSystem.Models.AppointmentStatus.NoShow" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Mark No Show">
                                            No Show
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>