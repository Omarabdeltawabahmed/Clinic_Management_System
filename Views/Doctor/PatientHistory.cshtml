@model IEnumerable<ClinicManagementSystem.Models.MedicalRecord>

@{
    ViewData["Title"] = "Patient Medical History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Medical History for: <span class="text-primary">@ViewBag.PatientName</span></h2>
        <a asp-action="CreateRecord" asp-route-appointmentId="@ViewBag.AppointmentId" class="btn btn-secondary">
            &larr; Back to Visit
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No previous medical records found for this patient.
        </div>
    }
    else
    {
        @foreach (var record in Model)
        {
            <div class="card mb-3 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Visit Date: @record.CreatedAt.ToString("yyyy-MM-dd HH:mm")</h5>
                    <span class="badge bg-success">Completed</span>
                </div>
                <div class="card-body">
                    <p><strong>Chief Complaint:</strong> @record.Complaint</p>
                    <p><strong>Diagnosis:</strong> @record.Diagnosis</p>
                    <p><strong>Prescription:</strong> @record.Prescription</p>

                    @if (!string.IsNullOrEmpty(record.AttachmentPath))
                    {
                        <div class="mt-2">
                            <strong>Attachment:</strong>
                            <a href="@record.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary ms-2">
                                View / Download File
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>